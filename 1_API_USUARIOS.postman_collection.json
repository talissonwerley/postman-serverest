						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonResponse = JSON.parse(responseBody);\r",
									"var jsonData = pm.response.json();\r",
									"\r",
									"console.log(jsonResponse)\r",
									"console.log(jsonData)\r",
									"\r",
									"pm.test(\"Status code is 200 OK\", function(){\r",
									"    pm.response.to.have.status(200)\r",
									"});\r",
									"\r",
									"pm.test(\"E-mail and password validation\", function (){\r",
									"    pm .expect(jsonResponse.nome).to.equal(\"Teste Testador da Silva\")\r",
									"});\r",
									"\r",
									"pm.test(\"Validação de ID de usuário\", function(){\r",
									"    pm.expect(jsonResponse._id).to.equal(pm.environment.get(\"user_id\"))\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
