		{
			"name": "2 - Autenticação",
			"item": [
				{
					"name": "Realiza Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonResponse = JSON.parse(responseBody);\r",
									"postman.setEnvironmentVariable(\"auth_token\", jsonResponse.authorization);\r",
									"\r",
									"//\r",
									"\r",
									"\r",
									"pm.test(\"Status code is 200 Created\", function(){\r",
