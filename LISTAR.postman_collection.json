		{
			"name": "Buscar Carrinhos",
			"item": [
				{
					"name": "Listar Carrinhos",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Faz o parse da resposta JSON\r",
									"let jsonResponse = pm.response.json();\r",
									"\r",
									"// \r",
									"pm.environment.set(\"id_carrinho\", jsonResponse._id);\r",
									"\r",
									"pm.test(\"Status code é 200 Created\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Resposta contém estrutura básica\", function () {\r",
									"    pm.expect(jsonResponse).to.have.property(\"quantidade\");\r",
									"    pm.expect(jsonResponse).to.have.property(\"carrinhos\");\r",
									"    pm.expect(jsonResponse.carrinhos).to.be.an(\"array\");\r",
									"});\r",
									"\r",
									"pm.test(\"Se houver carrinhos, eles devem ter os campos esperados\", function () {\r",
									"    if (jsonResponse.carrinhos.length > 0) {\r",
									"        const carrinho = jsonResponse.carrinhos[0];\r",
									"        pm.expect(carrinho).to.have.property(\"_id\");\r",
									"        pm.expect(carrinho).to.have.property(\"idUsuario\");\r",
									"        pm.expect(carrinho).to.have.property(\"produtos\");\r",
									"        pm.expect(carrinho).to.have.property(\"precoTotal\");\r",
									"        pm.expect(carrinho).to.have.property(\"quantidadeTotal\");\r",
									"    } else {\r",
									"        pm.expect(jsonResponse.quantidade).to.eql(0); // Verifica se realmente está vazio\r",
									"    }\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
