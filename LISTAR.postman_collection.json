							"script": {
								"exec": [
									"const jsonData = pm.response.json();\r",
									"\r",
									"pm.test(\"Status code é 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"A resposta contém um array de usuários\", function () {\r",
									"    pm.expect(jsonData.usuarios).to.be.an(\"array\");\r",
									"});\r",
									"\r",
									"pm.test(\"Existe ao menos um usuário na lista\", function () {\r",
									"    pm.expect(jsonData.usuarios.length).to.be.above(0);\r",
									"});\r",
									"\r",
									"pm.test(\"O campo 'quantidade' corresponde ao total de usuários\", function () {\r",
									"    pm.expect(jsonData.quantidade).to.eql(jsonData.usuarios.length);\r",
									"});"
